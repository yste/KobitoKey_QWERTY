#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <11 10>;
            bindings = <&kp TAB>;
        };

        ShiftTAB {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E     &kp R        &kp T            &kp Y          &kp U        &kp I      &kp O            &kp P
&mt LCTRL A       &kp S     &kp D     &kp F        &kp G            &kp H          &kp J        &kp K      &kp L            &mt RCTRL SEMI
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V        &kp B            &kp N          &kp M        &kp COMMA  &kp DOT          &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LALT  &kp LCMD  &lt 3 SPACE  &lt 4 BACKSPACE  &kp RIGHT_GUI  &lt 1 ENTER  &kp ESC    &lt 2 BACKSLASH  &mt LALT SLASH
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp MINUS  &kp N7  &kp N8  &kp N9  &kp PLUS      &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp SLASH  &kp N4  &kp N5  &kp N6  &kp ASTERISK  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL     &kp F11  &kp F12  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans        &trans   &trans   &trans  &trans  &trans
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans        &trans        &trans        &trans        &bt BT_CLR      &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &kp F11  &kp F12  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans   &trans   &trans  &trans  &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &kp LS(LC(TAB))         &kp LS(LG(N4))  &kp LC(TAB)              &kp LG(LS(N5))  &trans  &trans          &mkp MB3        &trans           &trans
&kp HOME   &kp LEFT_ARROW          &kp UP_ARROW    &kp RIGHT_ARROW          &kp END         &trans  &mkp MB1        &kp UP_ARROW    &mkp MB2         &trans
&trans     &kp LS(LG(LEFT_ARROW))  &kp DOWN_ARROW  &kp LS(LG(RIGHT_ARROW))  &trans          &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp LSHFT  &trans                  &trans          &trans                   &trans          &trans  &trans          &trans          &to 0            &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR     &kp PERCENT     &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp PLUS       &kp UNDERSCORE  &kp EQUAL  &kp MINUS      &kp SLASH     &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans         &trans        &kp BACKSLASH  &kp PIPE        &kp TILDE  &kp GRAVE      &kp SQT       &kp LEFT_BRACE        &kp RIGHT_BRACE
&trans           &trans         &trans        &trans         &trans          &trans     &trans         &trans        &trans                &kp PIPE
            >;
        };
    };
};
